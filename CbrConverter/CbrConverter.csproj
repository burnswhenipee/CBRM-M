<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>CbrConverter</RootNamespace>
    <AssemblyName>CBRM-M</AssemblyName>
    <ApplicationIcon>cbrmm.ico</ApplicationIcon>

    <!-- shown in the exe's Properties > Details; the release workflow sets Version from the release tag -->
    <Version>2.1.0</Version>
    <AssemblyTitle>CBRMix&amp;Match</AssemblyTitle>
    <Product>CBRMix&amp;Match</Product>
    <Company />
    <Copyright>Copyright © 2012-2026 the cbr-converter, CbrPdfConverter and CBRMix&amp;Match contributors</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="iTextSharp" Version="5.5.13.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="cbrmm.ico" LogicalName="CbrConverter.cbrmm.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
